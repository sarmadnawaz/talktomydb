# --- Required in production ---

# Used to encrypt the session cookie that holds the user's Postgres
# connection string. Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Anthropic API key for SQL generation. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional ---

# If set, the app requires this password before any DB connection step.
# Use for the hosted demo. Leave unset for local dev.
APP_PASSWORD=
